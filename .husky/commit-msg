# Conventional Commits (semantic-release parses these on main).
npx --no -- commitlint --edit "$1"

# No AI attribution in commit messages (project rule, see CLAUDE.md).
if grep -qiE '^co-authored-by:.*(claude|anthropic)|^claude-session:|generated with.*claude' "$1"; then
  echo "commit-msg: remove Claude attribution trailers (Co-Authored-By / Claude-Session / 'Generated with')." >&2
  exit 1
fi
