{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rm *)",
      "Bash(git mv *)"
    ],
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
