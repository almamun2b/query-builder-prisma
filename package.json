{
  "name": "query-builder-prisma",
  "version": "0.2.0",
  "description": "Type-safe, fluent query builder for Prisma: search, filter, sort, offset and cursor pagination, select/include projections. Zero dependencies, works with every Prisma version and database.",
  "license": "MIT",
  "author": {
    "name": "Mamun",
    "url": "https://github.com/almamun2b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almamun2b/query-builder-prisma.git"
  },
  "homepage": "https://almamun2b.github.io/query-builder-prisma/",
  "bugs": {
    "url": "https://github.com/almamun2b/query-builder-prisma/issues"
  },
  "keywords": [
    "prisma",
    "prisma-client",
    "prisma-orm",
    "prisma-query-builder",
    "prisma-pagination",
    "prisma-filter",
    "prisma-search",
    "query-builder",
    "querybuilder",
    "pagination",
    "cursor-pagination",
    "offset-pagination",
    "keyset-pagination",
    "seek-pagination",
    "infinite-scroll",
    "typescript",
    "type-safe",
    "typesafe",
    "orm",
    "fluent",
    "fluent-api",
    "filtering",
    "sorting",
    "findMany",
    "zero-dependency",
    "nestjs",
    "nextjs",
    "express",
    "postgresql",
    "mysql",
    "sqlite",
    "mongodb",
    "sqlserver",
    "cockroachdb",
    "mariadb"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild": true
  }
}
