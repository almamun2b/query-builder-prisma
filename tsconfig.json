{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    // Type tests declare `type _1 = Expect<...>` aliases purely for the
    // compiler; ESLint's no-unused-vars (with the `_` prefix) covers tests.
    "noUnusedLocals": false
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
